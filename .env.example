# LLM
# Default provider is Ollama (free, local, no key needed — see README).
# Required if config.yaml sets llm.provider: gemini — get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only required if config.yaml sets llm.provider: anthropic
ANTHROPIC_API_KEY=

# Optional data-source providers — agents degrade gracefully without these,
# but results (esp. Instagram/YouTube/SEO/Ads) improve significantly with them.
SERPAPI_KEY=
YOUTUBE_API_KEY=
META_GRAPH_API_TOKEN=
FACEBOOK_AD_LIBRARY_TOKEN=
